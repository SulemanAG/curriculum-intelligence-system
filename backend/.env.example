# ========================================================
# Curriculum Intelligence System — Backend Environment Config
# ========================================================

# Server Port (8081 to avoid conflict with Apache on 8080)
SERVER_PORT=8081

# PostgreSQL Configuration
DB_URL=jdbc:postgresql://localhost:5432/curriculum_intelligence
DB_USERNAME=curriculum_app
DB_PASSWORD=your_secure_db_password_here

# Legacy / Docker Alias Support
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/curriculum_intelligence
POSTGRES_DB=curriculum_intelligence
POSTGRES_USER=curriculum_app
POSTGRES_PORT=5432

# CORS Allowed Origins (Comma separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# LLM Agent Configuration (Gemini)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Web Search Provider Configuration
WEB_SEARCH_PROVIDER=google_grounding
WEB_SEARCH_API_KEY=your_web_search_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Embedding Configuration (Jina AI / TEI / OpenAI)
EMBEDDING_ENABLED=true
EMBEDDING_API_URL=https://api.jina.ai/v1/embeddings
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=jina-embeddings-v2-base-en
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32

# Audit & Governance
AUDIT_LOG_RETENTION_DAYS=365
DEFAULT_INSTITUTION=KLE Technological University, Belagavi
DEFAULT_DEPARTMENT=School of Computer Science & Engineering (AI)
